# frozen_string_literal: true

target :core do
  signature "../sig", "internal"
  library "uri"
  library "ipaddr"
  library "socket"
  library "json"
  library "zlib"
  check "../lib/connectrpc.rb", "../lib/connectrpc/version.rb"
  check "../lib/connectrpc/method.rb", "../lib/connectrpc/metadata.rb", "../lib/connectrpc/error.rb"
  check "../lib/connectrpc/cancellation.rb"
  check "../lib/connectrpc/deadline.rb", "../lib/connectrpc/keepalive.rb", "../lib/connectrpc/protocol.rb"
  check "../lib/connectrpc/client.rb", "../lib/connectrpc/proxy.rb"
  check "../lib/connectrpc/server.rb", "../lib/connectrpc/instrumentation.rb", "../lib/connectrpc/interceptors.rb"
  check "../lib/connectrpc/compression.rb", "../lib/connectrpc/message_io.rb", "../lib/connectrpc/get_query.rb"
  check "../lib/connectrpc/streaming/*.rb", "../lib/connectrpc/grpc*.rb"
  check "../lib/connectrpc/metrics.rb", "../lib/connectrpc/metrics/*.rb"
  configure_code_diagnostics(Steep::Diagnostic::Ruby.strict)
end
