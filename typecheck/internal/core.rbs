# Ruby's Numeric base signature omits arithmetic supplied by concrete real numeric types.
# Deadline requires that arithmetic at runtime too; this does not validate custom numerics.
class Numeric
  def *: (Numeric) -> Numeric
end
# Implementation-only contracts. This directory is never included in a gem.
module ConnectRPC
  # A call's timeout and supplied deadline, resolved once at call setup.
  type call_limit = [Numeric?, Deadline?]
  class Method[Req, Resp]
    IDENTIFIER: Regexp
    QUALIFIED_NAME: Regexp
    def self.validate_name!: (String, ?qualified: bool) -> nil
  end
  class Service
    private
    def validate_rpcs!: (String, Array[declaration]) -> nil
    def service_method?: (declaration, String) -> bool
  end
  class Metadata
    RESERVED: Array[String]
    @values: headers
    def self.base64_payload: (String) -> String
    private
    def validate_key: (String) -> String
    def validate_value: (String) -> String
  end
  class Error
    HTTP_STATUS: Hash[String, Integer]
    HTTP_FALLBACK: Hash[Integer, String]
    private
    def safe_message: (String) -> String
  end
  interface _IdentityProbe
    def equal?: (untyped) -> bool
  end
  class Deadline
    MONOTONIC: ^() -> Float
    def self.expired: () -> Deadline
    @clock: ^() -> Numeric | _Clock
    @expires_at: Numeric
    attr_reader clock: ^() -> Numeric | _Clock
    attr_reader expires_at: Numeric
    private
    def earlier_than?: (Deadline other) -> bool
  end
  class Context
    @cancellation: CallCancellation
    def commit!: () -> nil
    def close: () -> nil
    @lifecycle: Instrumentation::Handle?
  end
  module Protocol
    DEFAULT_LIMIT: Integer
    USER_AGENT: String
    CONTENT_TYPES: Hash[Symbol, String]
    type wire_error = { code: String, message: String, details: Array[ErrorDetail] }
    def self.limit!: (Integer) -> Integer
    def self.codec!: (codec) -> codec
    def self.binding!: (_Binding?) -> _Binding
    def self.call_deadline: (Numeric?, Deadline?) -> Deadline?
    def self.profile!: (server_protocol_selection, :unary, encoding, ?server: bool) -> nil
    def self.valid_server_protocol?: (server_protocol_selection) -> bool
    def self.server_protocols: (server_protocol_selection) -> Array[server_protocol]
    def self.content_codec: (String?) -> codec?
    def self.headers: (headers | Metadata) -> headers
    def self.single: (headers, String) -> String?
    def self.identity_encoding?: (headers) -> bool?
    def self.content_encoding: (headers) -> encoding?
    def self.accept_encoding!: (Array[encoding]?, encoding) -> Array[encoding]
    def self.response_encoding: (headers, encoding, encoding) -> encoding
      | (headers, encoding?, encoding) -> encoding?
    def self.gzip_acceptable?: (String) -> bool
    def self.metadata: (headers, ?trailers: bool) -> Metadata
    def self.check_size!: (String, Integer) -> nil
    def self.content_length!: (Array[String]?, invalid_code: Symbol) -> Integer?
    def self.error_body: (Error, Integer) ?{ (Error, String?) -> void } -> [String, Integer]
    def self.parse_error: (Integer, headers, String) -> Error
    # JSON is untrusted external data. Only the validated wire record leaves parsing.
    def self.wire_error: (String, fallback: String) -> wire_error?
    def self.wire_error_fields: (untyped, fallback: String) -> wire_error
    def self.valid_wire_error?: (untyped) -> bool
    def self.wire_details: (untyped) -> Array[ErrorDetail]
  end
  type encoding = :identity | :gzip
  class Compression
    CHUNK_SIZE: Integer
    @limit: Integer
    @deadline: _Check?
    @on_error: (^(StandardError) -> void)?
    @output: String
    class Malformed < StandardError
    end
    def self.encode: (String, limit: Integer, ?deadline: _Check?, ?on_error: (^(StandardError) -> void)?) -> String
    def self.decode: (String, limit: Integer, ?deadline: _Check?, ?on_error: (^(StandardError) -> void)?) -> String
    def initialize: (Integer, _Check?, ?on_error: (^(StandardError) -> void)?) -> void
    def encode: (String) -> String
    def decode: (String) -> String
    private
    def chunks: (String) { (String) -> void } -> nil
    def member: (String, Integer) -> Integer
    def inflate_chunk: (Zlib::Inflate, String) -> Integer
    def step: [T] () { () -> T } -> T
    def check_after_failure: (StandardError) -> void
    def record_failure: (StandardError) -> void
    def append: (String) -> nil
  end
  class GetQuery
    KEYS: Array[String]
    @wire_limit: Integer
    @deadline: _Check?
    def self.parse: (String, limit: Integer, wire_limit: Integer, ?deadline: _Check?) -> Hash[String, String]
    def initialize: (Integer, _Check?) -> void
    def parse: (String) -> Hash[String, String]
    def self.payload: (Hash[String, String], limit: Integer, ?deadline: _Check?, ?on_error: (^(StandardError) -> void)?) -> String
    def self.decode_base64: (String, Integer, ?(^(StandardError) -> void)?) -> String
    def self.build: (URI::Generic, String, codec: codec, encoding: encoding, limit: Integer, ?deadline: _Check?) -> URI::Generic
    def self.form_size: (String, _Check?) -> Integer
    def self.form_safe?: (Integer) -> bool
    private
    def field: (String, Integer) -> [Integer, Integer]
    def component: (String, Integer, Integer, Integer, ?payload: bool) -> String
    def hex: (Integer?) -> Integer
  end
  class MessageIO
    @input: _Input?
    @limit: Integer
    @context: Context
    def initialize: (_Input?, Integer, Context) -> void
    def read: (Integer?) -> String
    private
    def read_chunk: (_Input, Integer) -> String?
    def read_chunks: (String) -> nil
  end
  interface _TransportClassProbe
    def class: () -> Class
  end
  class Client
    @protocol: :connect | :grpc
    @grpc_status_wire_limit: Integer
    @grpc_status_limit: Integer
    @status_codec: _GRPCStatusCodec?
    @use_get: bool
    @get_url_limit: Integer
    @base_url: URI::Generic
    @binding: _Binding
    @transport: _Transport | _StreamingTransport | _GRPCTransport
    @codec: codec
    @encoding: encoding
    @accept_encoding: Array[encoding]
    @request_limit: Integer
    @response_limit: Integer
    @request_wire_limit: Integer
    @response_wire_limit: Integer
    @instrumentation: Instrumentation?
    @unary_interceptors: Interceptors::Chain?
    @stream_interceptors: Interceptors::Chain?
    private
    def validate_call_options!: (Deadline?, CancellationToken?) -> nil
    def process_call: [Req, Resp] (Method[Req, Resp], Req, metadata_input, call_limit, CancellationToken?, ?lifecycle: Instrumentation::Handle?, ?injection: metadata_input?) ?{ (TransportResponse) -> void } -> Response[Resp]
    def exchange: [Req, Resp] (Method[Req, Resp], Req, Metadata, Deadline?, CallCancellation, Instrumentation::Handle?) ?{ (TransportResponse) -> void } -> Response[Resp]
    def intercept_call: [Req, Resp] (Interceptors::Chain, Method[Req, Resp], Req, Metadata, Deadline?, CallCancellation, Instrumentation::Handle?, metadata_input?) ?{ (TransportResponse) -> void } -> (Response[Resp] | StandardError)
    def dispatch_metadata: (ClientUnaryCall | ClientStreamCall, Instrumentation::Handle?, metadata_input?) -> Metadata
    def instrumented_call: [Req, Resp] (Method[Req, Resp], Req, metadata_input, call_limit, CancellationToken?) -> Response[Resp]
    def injected_metadata: (Metadata, metadata_input?) -> Metadata
    def parse_base_url: (String) -> URI::Generic
    def default_transport: () -> Transports::NetHTTP
    def encode_request: [Req, Resp] (Method[Req, Resp], Req, _Check?, ?Instrumentation::Handle?) -> String
    def build_request: [Req, Resp] (Method[Req, Resp], Req, Metadata, _Check?, ?Instrumentation::Handle?) -> TransportRequest
    def request_path: (declaration) -> String
    def request_facts: (declaration) -> { server_address: String?, server_port: Integer?, url_scheme: String?, url_path: String, transport_class: Class }
    def request_headers: (Metadata, Deadline?, ?get: bool) -> headers
    def default_user_agent: (headers, String) -> headers
    def compress_request: (String, _Check?, ?Instrumentation::Handle?) -> String
    def response_body: (TransportResponse, headers, _Check?, ?Instrumentation::Handle?) -> String
    def inflate_response: (String, Integer, _Check?, ?Instrumentation::Handle?) -> String
    def response_encoding!: (headers) -> encoding
    def validate_response!: (Integer, headers, String, ?StandardError?) -> nil
    def accept_response: (TransportResponse, _Check?, Instrumentation::Handle?) -> [headers, String]
    def read_response: [Req, Resp] (TransportResponse, Method[Req, Resp], _Check?, ?Instrumentation::Handle?) -> Response[Resp]
    def decode_response: [Req, Resp] (String, Method[Req, Resp], _Check?, ?Instrumentation::Handle?) -> Resp
  end
  class Server
    @protocol: Array[server_protocol]
    @cors: GRPCWebCORS?
    @grpc_status_wire_limit: Integer
    @grpc_status_limit: Integer
    @status_codec: _GRPCStatusCodec?
    @methods: Hash[String, declaration]
    @handlers: Hash[String, registered_handler]
    @invoker: ^(Method[untyped, untyped], untyped, Context) -> untyped | _Invoker
    @instrumentation: Instrumentation?
    @binding: _Binding
    @encoding: encoding
    @request_limit: Integer
    @response_limit: Integer
    @request_wire_limit: Integer
    @response_wire_limit: Integer
    @get_query_limit: Integer
    @error_limit: Integer
    @unary_interceptors: Interceptors::Chain?
    @stream_interceptors: Interceptors::Chain?
    @on_error: (^(StandardError) -> void | _ServerErrorHandler)?
    private
    def invoke_unary: (Method[untyped, untyped], untyped, Context, server_protocol) -> untyped
    def process_call: (path: String, http_method: String, headers: headers, input: _Input?, query: String, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation?, ?on_error: (^(StandardError) -> void | _ServerErrorHandler)?) -> TransportResponse
    def process_get: (String, headers, _Input?, String, Instrumentation::Handle?, _Cancellation?) { (Context) -> void } -> TransportResponse
    def empty_get_body?: (headers, _Input?, _Check?) -> bool
    def get_headers: (headers, Hash[String, String]) -> headers
    def vary_get: (TransportResponse) -> void
    def request_protocol: (headers, String) -> (:connect | :grpc | :grpc_web)
    AUTHORITY: Regexp
    def request_authority: (Array[String]?) -> [String?, Integer?]
    def ipv6_address?: (String) -> bool
    def declarations: (Array[Service]) -> Hash[String, declaration]
    def invoke_handler: (Method[untyped, untyped], untyped, Context) -> untyped
    def dispatch: (String, headers, _Input?, codec, Context, ?lifecycle: Instrumentation::Handle?) -> TransportResponse
    def inflate_request: (String, headers, Context) -> String
    def decode_request: (String, Method[untyped, untyped], codec, Context) -> untyped
    def encode_response: (untyped, Method[untyped, untyped], codec, Context, encoding?, ?Instrumentation::Handle?) -> TransportResponse
    def serialize_response: (untyped, Method[untyped, untyped], codec, Context) -> String
    def bare: (Integer, headers, ?context: Context?, ?cancellation: _Cancellation?) -> TransportResponse
    def record_request_metadata: (Instrumentation::Handle, headers) -> void
    def request_context: (headers, ?Instrumentation::Handle?, ?_Cancellation?) -> Context
    def validate_headers!: (headers) -> nil
    def request_deadline: (headers) -> Deadline?
    def response_headers: (Context?, String) -> headers
    def append_trailer_fields: (headers, Metadata) -> void
    def report_stream_error: (StandardError, Error, Streaming::ServerState | GRPCProtocol::ServerState | GRPCWeb::ServerState) -> nil
    def report_unexpected: (StandardError, ?(^(StandardError) -> void | _ServerErrorHandler)?) -> nil
    def terminal_error: (Error, Context?, _Cancellation?) -> Error
    def error_response: (Error, Context?, ?Instrumentation::Handle?) -> TransportResponse
  end
end

module ConnectRPC
  class Instrumentation
    @subscribers: Array[_Subscriber]
    @on_error: (^(StandardError) -> void | _InstrumentationErrorHandler)?
    def start: (owner: Object, role: :client | :server, method: declaration?, carrier: Hash[String, String | Array[String]], ?server_address: String?, ?server_port: Integer?, ?path: String?, ?protocol: :connect | :grpc | :grpc_web, ?url_scheme: String?, ?url_path: String?, ?transport_class: Class?) -> Handle
    def safely: [T] () { () -> T } -> T?
    EMPTY_HEADERS: headers
    def self.carrier: (headers | metadata_input) -> headers
    def self.unary_carriers: (headers) -> [headers, headers]
    # Reflection is erased here only, before each capability enters Callbacks.
    class Callbacks
      def self.discover: (Object, Instrumentation) -> Callbacks
      def self.callback: (Object, Symbol, Instrumentation) -> untyped
      def initialize: (attach: (^() -> Object?)?, detach: (^(Object?) -> void)?, processing_finished: (^(Outcome) -> void)?, finished: (^(Completion) -> void)?, message_received: (^(Integer) -> void)?, message_sent: (^(Integer) -> void)?) -> void
      attr_reader attach: (^() -> Object?)?
      attr_reader detach: (^(Object?) -> void)?
      attr_reader processing_finished: (^(Outcome) -> void)?
      attr_reader finished: (^(Completion) -> void)?
      attr_reader message_received: (^(Integer) -> void)?
      attr_reader message_sent: (^(Integer) -> void)?
    end
    class Handle
      type pending = { delivery: delivery, error: Exception?, decision: decision, http_status: Integer? }
      @bus: Instrumentation
      @owner: Object
      @path: String?
      @observers: Array[Callbacks]
      @started_at: Float
      @processing_at: Float?
      @processing_state: :not_started | :running | :finished
      @pending: pending?
      @terminal: bool?
      @notifying_processing: bool?
      @processing_held: bool?
      @host_rejected: bool?
      @error: Exception?
      def initialize: (Instrumentation, Object, String?, Array[Object]) -> void
      attr_reader outcome: Outcome?
      attr_accessor request_bytes: Integer?
      attr_accessor request_metadata: headers
      attr_accessor code: String?
      attr_accessor normalized_error: Exception?
      def begin_processing: (Object, ?String?) -> Float
      def processing_finished: (code: String?, ?http_status: Integer?, ?normalized_error: Exception?, ?error: Exception?, ?response_bytes: Integer?, ?response_metadata: headers | Metadata, ?response_trailers: headers | Metadata) -> nil
      def message_received: (Integer) -> nil
      def message_sent: (Integer) -> nil
      private
      def notify_message: (:message_received | :message_sent, Integer) -> nil
      def detach_tokens: (Array[[(^(Object?) -> void)?, Object?]]) -> nil
      def with_processing_completion: [T] () { () -> T } -> T
      def complete_processing: () -> nil
      def now: () -> Float
      def notify_processing: (Outcome) -> Array[Callbacks]
      def notify_finished: (Completion) -> Array[Callbacks]
      def complete: () -> Array[Callbacks]
    end
    class Outcome
      # Existing Data#with is used only by private processing finalization.
      def with: (duration: Float, error: Exception?) -> Outcome
    end
  end
end

module ConnectRPC
  interface _Check
    def check!: () -> nil
  end
  class CancellationRegistration
    @owner: CancellationSignal
    @callback: (^() -> void)?
    @mutex: Mutex
    @state: :registered | :running | :finished | :unregistered
    def initialize: (CancellationSignal) { () -> void } -> void
    def invoke: () -> void
  end
  class CancellationSignal
    @mutex: Mutex
    @cancelled: bool
    @registrations: Array[CancellationRegistration]
    def initialize: () -> void
    def cancelled?: () -> bool
    def cancel: () -> bool
    def on_cancel: () { () -> void } -> CancellationRegistration
    def remove: (CancellationRegistration) -> nil
  end
  class CancellationSource
    @signal: CancellationSignal
  end
  class CancellationToken
    @signal: CancellationSignal
    def initialize: (CancellationSignal) -> void
  end
  class CallCancellation
    class View
      @state: CallCancellation
      def initialize: (CallCancellation) -> void
      def cancelled?: () -> bool
      def reason: () -> cancellation_reason?
      def check!: () -> nil
      def on_cancel: () { () -> void } -> CancellationRegistration
    end
    def self.with_request: [T] (TransportRequest) { (TransportRequest) -> T } -> T
    attr_reader view: View
    @view: View
    @deadline: Deadline?
    @source: _Cancellation?
    @mutex: Mutex
    @terminal: :finished | cancellation_reason | nil
    @signal: CancellationSignal
    @registration: CancellationRegistration?
    def initialize: (?deadline: Deadline?, ?cancellation: _Cancellation?) -> void
    def reason: () -> cancellation_reason?
    def cancelled?: () -> bool
    def check!: () -> nil
    def on_cancel: () { () -> void } -> CancellationRegistration
    def commit!: () -> nil
    def close: () -> nil
    private
    def observe: (bool) -> cancellation_reason?
    def raise_reason: (cancellation_reason?) -> nil
  end
end

module ConnectRPC
  module Metrics
    CODES: Hash[String, String]
    OTHER: String
    def self.code: (String | Symbol) -> String
    def self.labels: (Instrumentation::Call) -> labels
    class Definitions
      UPSTREAM_HELP: Hash[Symbol, Hash[Symbol, String]]
      def self.namespace!: (untyped) -> String
      def self.buckets!: (untyped, String) -> Array[Numeric]
      def self.bound?: (untyped) -> bool
      private
      def rpc_instruments: (:server | :client, Array[Numeric], Array[Numeric]) -> Array[Instrument]
      def connection_instruments: (Array[Numeric]) -> Array[Instrument]
      def counter: (:server | :client, String, Array[Symbol], String) -> Instrument
      def gauge: (:server | :client, String, Array[Symbol], String) -> Instrument
      def histogram: (:server | :client, String, Symbol, Array[Symbol], Array[Numeric], String) -> Instrument
    end
    class Subscriber
      ROLE_KEYS: Array[Symbol]
      SERVER_KEYS: Array[Symbol]
      @recorder: _Recorder
      @keys: Hash[Symbol, Hash[Symbol, Symbol]]
      class Observer
        @recorder: _Recorder
        @keys: Hash[Symbol, Symbol]
        @server: bool
        @labels: labels
        def initialize: (_Recorder, Hash[Symbol, Symbol], bool, labels) -> void
        def message_received: (Integer) -> void
        def message_sent: (Integer) -> void
        def finished: (Instrumentation::Completion) -> void
        def self.code: (Instrumentation::Outcome?) -> String?
        private
        def rejection: (Instrumentation::Completion) -> String?
        def handled: (String, Float) -> void
        def reject: (String) -> void
      end
    end
    class ConnectionObserver
      OUTCOMES: Hash[Symbol, String]
      @recorder: _Recorder
      @labels: labels
      @keys: Hash[Symbol, Symbol]
      @state: Symbol
      @counts: Hash[Symbol, Integer]
      @mutex: Thread::Mutex
      def self.transport!: (untyped) -> String
      private
      def observe: (_ConnectionEvent) -> void
      def record_state: (Symbol, Symbol) -> void
      def record_counts: (Hash[Symbol, Integer], Hash[Symbol, Integer]?) -> void
      def attempt_finished: (Symbol?, Numeric?) -> void
      def set_state: (Symbol, Integer) -> void
      def state_labels: (Symbol) -> labels
    end
  end
end

module ConnectRPC
  interface _InterceptorProbe
    def respond_to?: (Symbol) -> bool
    def public_method: (Symbol) -> ::Method
  end
  interface _FailureRecorder
    def record_failure: (Exception) -> nil
  end
  class ClientUnaryCall
    @method: Method[untyped, untyped]
    @protocol: :connect | :grpc
    @request: untyped
    @request_metadata: Metadata
    @deadline: Deadline?
    @cancellation: _Cancellation
    @open: bool
    def initialize: (method: Method[untyped, untyped], protocol: :connect | :grpc, request: untyped, request_metadata: Metadata, deadline: Deadline?, cancellation: _Cancellation) -> void
    private
    def dispatch!: () -> nil
  end
  class ServerUnaryCall
    @method: Method[untyped, untyped]
    @protocol: server_protocol
    @request: untyped
    @context: Context
    @open: bool
    def initialize: (method: Method[untyped, untyped], protocol: server_protocol, request: untyped, context: Context) -> void
    private
    def dispatch!: () -> nil
  end
  class ClientStreamCall
    @method: stream_declaration
    @protocol: :connect | :grpc
    @request_metadata: Metadata
    @deadline: Deadline?
    @cancellation: _Cancellation
    @wrappers: Array[Proc]
    @open: bool
    def initialize: (method: stream_declaration, protocol: :connect | :grpc, request_metadata: Metadata, deadline: Deadline?, cancellation: _Cancellation) -> void
    private
    def dispatch!: () -> nil
    def wrap: (untyped) -> untyped
  end
  class ClientStreamCall::ServerStreaming
    @request: untyped
    def initialize: (method: stream_declaration, protocol: :connect | :grpc, request: untyped, request_metadata: Metadata, deadline: Deadline?, cancellation: _Cancellation) -> void
  end
  class ServerStreamCall
    @method: stream_declaration
    @protocol: server_protocol
    @context: StreamingContext
    @wrappers: Array[Proc]
    @open: bool
    def initialize: (method: stream_declaration, protocol: server_protocol, context: StreamingContext) -> void
    private
    def dispatch!: () -> nil
    def wrap: (untyped) -> untyped
  end
  class ServerStreamCall::ServerStreaming
    @request: untyped
    def initialize: (method: stream_declaration, protocol: server_protocol, request: untyped, context: StreamingContext) -> void
  end
  type interceptor_call = ClientUnaryCall | ServerUnaryCall | ClientStreamCall | ServerStreamCall
  module Interceptors
    def self.client: (Array[client_interceptor]) -> [Chain?, Chain?]
    def self.server: (Array[server_interceptor]) -> [Chain?, Chain?]
    def self.build: (Array[client_interceptor] | Array[server_interceptor], Symbol, Symbol) -> [Chain?, Chain?]
    def self.chain: (Array[client_interceptor] | Array[server_interceptor], Symbol) -> Chain?
    def self.response!: (untyped) -> Response[untyped]
    def self.wrap: (Array[Proc], untyped) -> untyped
    class Chain
      type mode = :response | :stream_response | :value | :ignored
      @layers: Array[::Method]
      @kind: Symbol
      def initialize: (Array[::Method], Symbol) -> void
      def run: (interceptor_call, _FailureRecorder?) { () -> untyped } -> untyped
      private
      def mode: (interceptor_call) -> mode
      def step: (Integer, interceptor_call, _FailureRecorder?, ^() -> untyped, Continuation?, mode) -> untyped
      def innermost: (^() -> untyped, mode) -> untyped
    end
    class Continuation
      @recorder: _FailureRecorder?
      @fiber: Fiber
      @mutex: Thread::Mutex
      @state: :active | :claimed | :finished
      @failure: Exception?
      @misuse: InterceptorStateError?
      @handed_up: Exception?
      def initialize: (_FailureRecorder?) -> void
      def call: [T] () { () -> T } -> T
      def close: (Continuation?) -> bool
      def finish: (untyped, bool, Chain::mode) -> untyped
      def hand_up: (Exception?) -> nil
      private
      def claim: () -> InterceptorStateError?
      def claim_owned: () -> InterceptorStateError?
      def record_misuse: (InterceptorStateError) -> nil
      def latch_foreign: () -> InterceptorStateError
      def raise_latched: () -> nil
    end
  end
  module Proxy
    interface _Environment
      def fetch: (String, nil) -> String?
    end
    interface _PrettyPrinter
      def text: (String) -> void
    end
    type ip_matcher = [IPAddr, String, bool]
    type domain_matcher = [String, String, bool]
    type resolver = Static | Environment
    AUTHORITY: Regexp
    PROXY_PORTS: Hash[String, Integer]
    TARGET_PORTS: Hash[String, Integer]
    class Endpoint
      def initialize: (scheme: String, host: String, port: Integer?, user: String?, password: String?) -> void
      attr_reader scheme: String
      attr_reader host: String
      attr_reader port: Integer?
      attr_reader user: String?
      attr_reader password: String?
      def inspect: () -> String
      def to_s: () -> String
      def pretty_print: (_PrettyPrinter) -> void
    end
    class Unusable < StandardError
      attr_reader reason: Symbol
      def initialize: (Symbol) -> void
    end
    def self.resolver: (:environment | String | URI::Generic | nil, ?_Environment) -> resolver
    def self.explicit: (String | URI::Generic) -> Endpoint
    def self.parse: (String) -> URI::Generic?
    def self.uri: (String) -> URI::Generic?
    def self.utf8: (untyped) -> String?
    def self.ascii_host: (String) -> String
    def self.endpoint: (URI::Generic) -> Endpoint?
    def self.split_host_port: (String) -> [String, String]?
    def self.ip: (String) -> IPAddr?
    module Punycode
      BASE: Integer
      T_MIN: Integer
      T_MAX: Integer
      SKEW: Integer
      DAMP: Integer
      def self.encode: (String) -> String
      def self.digits: (Integer, Integer) -> String
      def self.digit: (Integer) -> String
      def self.adapt: (Integer, Integer, bool) -> Integer
    end
    class Static
      @endpoint: Endpoint?
      attr_reader endpoint: Endpoint?
      def initialize: (Endpoint?) -> void
      def for: (URI::Generic) -> Endpoint?
      def inspect: () -> String
    end
    class Environment
      @http: String?
      @https: String?
      @cgi: bool
      @all: bool
      @ip_matchers: Array[ip_matcher]
      @domain_matchers: Array[domain_matcher]
      def initialize: (_Environment) -> void
      def inspect: () -> String
      def for: (URI::Generic) -> Endpoint?
      private
      def value: (_Environment, *String) -> String?
      def use_proxy?: (URI::Generic, String) -> bool
      def ip_match?: (ip_matcher, IPAddr, String) -> bool
      def domain_match?: (domain_matcher, String, String) -> bool
      def no_proxy: (String?) -> nil
      def cidr: (String) -> IPAddr?
    end
  end
end
