    def write: (String) -> nil
    def close_send: () -> nil
    def response_trailers: () -> headers?
    def finish: (?timeout: Numeric?) -> nil
    def abort: () -> nil
  end
  interface _GRPCOutput
    def write: (String, ?timeout: Numeric?) -> nil
    def finish: (headers: headers) -> nil
    def abort: () -> nil
  end
  interface _PublishGRPCHead
    def call: (GRPCHead) -> void
  end
  class GRPCHead
    def initialize: (status: Integer, headers: headers, end_stream: bool) -> void
    attr_reader status: Integer
    attr_reader headers: headers
    attr_reader end_stream: bool
  end
  class Server
    def call_grpc: (path: String, http_method: String, headers: headers, input: _StreamingInput, output: _GRPCOutput, publish: _PublishGRPCHead | ^(GRPCHead) -> void, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation?, ?http2: bool) -> TransportResponse?
  end
end

