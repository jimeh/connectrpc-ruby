module ConnectRPC
  VERSION: String
  type idempotency = :unknown | :no_side_effects | :idempotent
  type codec = :proto | :json
  type headers = Hash[String, Array[String]]
  type metadata_input = Metadata | Hash[String, String | Array[String]]

  # Tokens belong to the binding. Only schema facts or an application assertion
  # associate them with instance types; the constructor cannot infer that link.
  class Method[Req, Resp]
    def initialize: (service: String, name: String, request_type: Object, response_type: Object, ?cardinality: :unary, ?idempotency: idempotency) -> void
    attr_reader service: String
    attr_reader name: String
    attr_reader idempotency: idempotency
    attr_reader path: String
    attr_reader request_type: Object
    attr_reader response_type: Object
    def cardinality: () -> :unary
  end

  class Service
    def initialize: (name: String, methods: Array[Method[untyped, untyped]]) -> void
    attr_reader name: String
    attr_reader methods: Array[Method[untyped, untyped]]
  end

  # Custom token-based codecs erase message identity at this boundary.
  interface _Binding
    def encode: (untyped message, type: Object, codec: codec) -> String
    def decode: (String bytes, type: Object, codec: codec) -> untyped
  end

  interface _Transport
    def call: (TransportRequest) -> TransportResponse
  end

  type cancellation_reason = :canceled | :deadline_exceeded

  # Read-only transport/host cancellation SPI. Each call owns its arbitration.
  interface _Cancellation
    def cancelled?: () -> bool
    def reason: () -> cancellation_reason?
    def check!: () -> nil
    def on_cancel: () { () -> void } -> CancellationRegistration
  end

  class CancellationSource
    def initialize: () -> void
    attr_reader token: CancellationToken
    def cancel: () -> bool
  end

  class CancellationToken
    def cancelled?: () -> bool
    def reason: () -> (:canceled | nil)
    def check!: () -> nil
    def on_cancel: () { () -> void } -> CancellationRegistration
  end

  class CancellationRegistration
    def unregister: () -> bool
  end

  interface _Input
    def read: (Integer) -> String?
  end

  interface _Handler[Req, Resp]
    def call: (Req, Context) -> Resp
  end

  interface _Subscriber
    # Observers may implement any of attach, detach, processing_finished, finished.
    # Ruby's optional structural methods are deliberately not required here.
    def start: (Instrumentation::Call) -> Object?
  end

  class Instrumentation
    type delivery = :unobserved | :body_closed | :response_finished | :completed | :aborted
    type decision = :processed | :admission_rejected | :host_rejected
    def initialize: (subscribers: Array[_Subscriber], ?on_error: (^(StandardError) -> void | _InstrumentationErrorHandler)?) -> void

    class Call
      def initialize: (role: :client | :server, protocol: :connect, method: Method[untyped, untyped]?, server_address: String?, server_port: Integer?, carrier: Hash[String, String | Array[String]]) -> void
        | (:client | :server, :connect, Method[untyped, untyped]?, String?, Integer?, Hash[String, String | Array[String]]) -> void
      attr_reader role: :client | :server
      attr_reader protocol: :connect
      attr_reader method: Method[untyped, untyped]?
      attr_reader server_address: String?
      attr_reader server_port: Integer?
      attr_reader carrier: Hash[String, String | Array[String]]
    end

    class Outcome
      def initialize: (code: String?, http_status: Integer?, error: Exception?, normalized_error: Exception?, duration: Float, request_bytes: Integer?, response_bytes: Integer?, request_metadata: headers, response_metadata: headers) -> void
        | (String?, Integer?, Exception?, Exception?, Float, Integer?, Integer?, headers, headers) -> void
      attr_reader code: String?
      attr_reader http_status: Integer?
      attr_reader error: Exception?
      attr_reader normalized_error: Exception?
      attr_reader duration: Float
      attr_reader request_bytes: Integer?
      attr_reader response_bytes: Integer?
      attr_reader request_metadata: headers
      attr_reader response_metadata: headers
    end

    class Completion
      def initialize: (outcome: Outcome?, processing_state: :not_started | :running | :finished, decision: decision, delivery: delivery, error: Exception?, http_status: Integer?, duration: Float) -> void
        | (Outcome?, :not_started | :running | :finished, decision, delivery, Exception?, Integer?, Float) -> void
      attr_reader outcome: Outcome?
      attr_reader processing_state: :not_started | :running | :finished
      attr_reader decision: decision
      attr_reader delivery: delivery
      attr_reader error: Exception?
      attr_reader http_status: Integer?
      attr_reader duration: Float
    end

    class Handle
      def record_failure: (Exception) -> nil
      def host_rejected!: () -> bool
      def host_rejected?: () -> bool
      def activate: [T] () { () -> T } -> T
      def finish: (delivery: delivery, ?error: Exception?, ?decision: decision, ?http_status: Integer?) -> nil
    end
  end

  interface _Clock
    def call: () -> Numeric
  end

  interface _Invoker
    def call: (Method[untyped, untyped], untyped, Context) -> untyped
  end

  interface _InstrumentationErrorHandler
    def call: (StandardError) -> void
  end

  interface _ObserverAttach
    def attach: () -> Object?
  end
  interface _ObserverDetach
    def detach: (Object?) -> void
  end
  interface _ObserverProcessingFinished
    def processing_finished: (Instrumentation::Outcome) -> void
  end
  interface _ObserverFinished
    def finished: (Instrumentation::Completion) -> void
  end

  module Bindings
    class GoogleProtobuf
      def initialize: () -> void
      def encode: (untyped message, type: Object, codec: codec) -> String
      def decode: (String bytes, type: Object, codec: codec) -> untyped
    end
  end

  module Transports
    class NetHTTP
      def initialize: () -> void
      def call: (TransportRequest) -> TransportResponse
    end
  end

  class Client
    def initialize: (base_url: String, binding: _Binding, ?transport: _Transport?, ?codec: codec, ?request_limit: Integer, ?response_limit: Integer, ?request_wire_limit: Integer, ?response_wire_limit: Integer, ?accept_encoding: Array[:identity | :gzip]?, ?use_get: bool, ?get_url_limit: Integer, ?protocol: :connect, ?mode: :unary, ?encoding: :identity | :gzip, ?instrumentation: Instrumentation?) -> void
    def call: [Req, Resp] (Method[Req, Resp], Req request, ?metadata: metadata_input, ?timeout: Numeric?, ?cancellation: CancellationToken?) -> Response[Resp]
  end

  class Server
    # Generated .handlers checks each concrete callable before this heterogeneous
    # registration map erases its individual request/response associations.
    def initialize: (services: Array[Service], binding: _Binding, ?handlers: Hash[String, ^(untyped, Context) -> untyped | _Handler[untyped, untyped]], ?invoker: (^(Method[untyped, untyped], untyped, Context) -> untyped | _Invoker)?, ?request_limit: Integer, ?response_limit: Integer, ?request_wire_limit: Integer, ?response_wire_limit: Integer, ?protocol: :connect, ?mode: :unary, ?encoding: :identity | :gzip, ?instrumentation: Instrumentation?, ?get_query_limit: Integer?) -> void
    attr_reader services: Array[Service]
    def handles?: (String path) -> bool
    def start_call: (path: String, headers: headers) -> Instrumentation::Handle?
    def call: (path: String, http_method: String, headers: headers, input: _Input?, ?query: String, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation?) -> TransportResponse
  end

  # Complete records retain precise readers; partial construction admits nil defaults.
  interface _PartialResponse[M]
    def message: () -> M
    def message=: (M) -> M
    def metadata: () -> Metadata?
    def metadata=: (Metadata?) -> Metadata?
    def trailers: () -> Metadata?
    def trailers=: (Metadata?) -> Metadata?
    def []: (:message | "message" | 0 | -3) -> M
      | (:metadata | "metadata" | 1 | -2) -> Metadata?
      | (:trailers | "trailers" | 2 | -1) -> Metadata?
    def []=: (:message | "message" | 0 | -3, M) -> M
      | (:metadata | "metadata" | 1 | -2, Metadata?) -> Metadata?
      | (:trailers | "trailers" | 2 | -1, Metadata?) -> Metadata?
    def to_h: () -> Hash[Symbol, M? | Metadata?]
    def members: () -> Array[Symbol]
    def size: () -> Integer
    def length: () -> Integer
    def to_a: () -> Array[M? | Metadata?]
    def values: () -> Array[M? | Metadata?]
    def deconstruct: () -> Array[M? | Metadata?]
    def each: () { (M | Metadata | nil) -> void } -> self
            | () -> Enumerator[M | Metadata | nil, self]
    def each_pair: () { ([Symbol, M | Metadata | nil]) -> void } -> self
                 | () -> Enumerator[[Symbol, M | Metadata | nil], self]
    def deconstruct_keys: (Array[Symbol]?) -> Hash[Symbol, M | Metadata | nil]
    def values_at: (*(Integer | Range[Integer])) -> Array[M | Metadata | nil | nil]

  end

  class Response[M]
    def self.new: [T] (message: T, metadata: Metadata, trailers: Metadata) -> Response[T]
      | [T] ({ message: T, metadata: Metadata, trailers: Metadata }) -> Response[T]
      | [T] (message: T, ?metadata: Metadata?, ?trailers: Metadata?) -> _PartialResponse[T]
      | [T] ({ message: T, ?metadata: Metadata?, ?trailers: Metadata? }) -> _PartialResponse[T]
      | (?metadata: Metadata?, ?trailers: Metadata?) -> _PartialResponse[nil]
      | ({ ?metadata: Metadata?, ?trailers: Metadata? }) -> _PartialResponse[nil]
    def self.[]: [T] (message: T, metadata: Metadata, trailers: Metadata) -> Response[T]
      | [T] ({ message: T, metadata: Metadata, trailers: Metadata }) -> Response[T]
      | [T] (message: T, ?metadata: Metadata?, ?trailers: Metadata?) -> _PartialResponse[T]
      | [T] ({ message: T, ?metadata: Metadata?, ?trailers: Metadata? }) -> _PartialResponse[T]
      | (?metadata: Metadata?, ?trailers: Metadata?) -> _PartialResponse[nil]
      | ({ ?metadata: Metadata?, ?trailers: Metadata? }) -> _PartialResponse[nil]
    attr_accessor message: M
    attr_accessor metadata: Metadata
    attr_accessor trailers: Metadata
    def []: (:message | "message" | 0 | -3) -> M
      | (:metadata | "metadata" | 1 | -2) -> Metadata
      | (:trailers | "trailers" | 2 | -1) -> Metadata
    def []=: (:message | "message" | 0 | -3, M) -> M
      | (:metadata | "metadata" | 1 | -2, Metadata) -> Metadata
      | (:trailers | "trailers" | 2 | -1, Metadata) -> Metadata
    def to_h: () -> Hash[Symbol, M | Metadata]
    def members: () -> Array[Symbol]
    def size: () -> Integer
    def length: () -> Integer
    def to_a: () -> Array[M | Metadata]
    def values: () -> Array[M | Metadata]
    def deconstruct: () -> Array[M | Metadata]
    def each: () { (M | Metadata) -> void } -> self
            | () -> Enumerator[M | Metadata, self]
    def each_pair: () { ([Symbol, M | Metadata]) -> void } -> self
                 | () -> Enumerator[[Symbol, M | Metadata], self]
    def deconstruct_keys: (Array[Symbol]?) -> Hash[Symbol, M | Metadata]
    def values_at: (*(Integer | Range[Integer])) -> Array[M | Metadata | nil]

  end

  interface _PartialTransportRequest
    def url: () -> URI::Generic?
    def url=: (URI::Generic?) -> URI::Generic?
    def http_method: () -> String?
    def http_method=: (String?) -> String?
    def headers: () -> headers?
    def headers=: (headers?) -> headers?
    def body: () -> String?
    def body=: (String?) -> String?
    def response_limit: () -> Integer?
    def response_limit=: (Integer?) -> Integer?
    def deadline: () -> Deadline?
    def deadline=: (Deadline?) -> Deadline?
    def lifecycle: () -> Instrumentation::Handle?
    def lifecycle=: (Instrumentation::Handle?) -> Instrumentation::Handle?
    def cancellation: () -> _Cancellation?
    def cancellation=: (_Cancellation?) -> _Cancellation?
    def []: (:url | "url" | 0 | -8) -> URI::Generic?
      | (:http_method | "http_method" | 1 | -7) -> String?
      | (:headers | "headers" | 2 | -6) -> headers?
      | (:body | "body" | 3 | -5) -> String?
      | (:response_limit | "response_limit" | 4 | -4) -> Integer?
      | (:deadline | "deadline" | 5 | -3) -> Deadline?
      | (:lifecycle | "lifecycle" | 6 | -2) -> Instrumentation::Handle?
      | (:cancellation | "cancellation" | 7 | -1) -> _Cancellation?
    def []=: (:url | "url" | 0 | -8, URI::Generic?) -> URI::Generic?
      | (:http_method | "http_method" | 1 | -7, String?) -> String?
      | (:headers | "headers" | 2 | -6, headers?) -> headers?
      | (:body | "body" | 3 | -5, String?) -> String?
      | (:response_limit | "response_limit" | 4 | -4, Integer?) -> Integer?
      | (:deadline | "deadline" | 5 | -3, Deadline?) -> Deadline?
      | (:lifecycle | "lifecycle" | 6 | -2, Instrumentation::Handle?) -> Instrumentation::Handle?
      | (:cancellation | "cancellation" | 7 | -1, _Cancellation?) -> _Cancellation?
    def to_h: () -> Hash[Symbol, URI::Generic? | String? | headers? | Integer? | Deadline? | Instrumentation::Handle? | _Cancellation?]
    def members: () -> Array[Symbol]
    def size: () -> Integer
    def length: () -> Integer
    def to_a: () -> Array[URI::Generic? | String? | headers? | Integer? | Deadline? | Instrumentation::Handle? | _Cancellation?]
    def values: () -> Array[URI::Generic? | String? | headers? | Integer? | Deadline? | Instrumentation::Handle? | _Cancellation?]
    def deconstruct: () -> Array[URI::Generic? | String? | headers? | Integer? | Deadline? | Instrumentation::Handle? | _Cancellation?]
    def each: () { (URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil) -> void } -> self
            | () -> Enumerator[URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil, self]
    def each_pair: () { ([Symbol, URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil]) -> void } -> self
                 | () -> Enumerator[[Symbol, URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil], self]
    def deconstruct_keys: (Array[Symbol]?) -> Hash[Symbol, URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil]
    def values_at: (*(Integer | Range[Integer])) -> Array[URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil | nil]

  end

  class TransportRequest
    def self.new: (url: URI::Generic, http_method: String, headers: headers, body: String, response_limit: Integer, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation?) -> TransportRequest
      | ({ url: URI::Generic, http_method: String, headers: headers, body: String, response_limit: Integer, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation? }) -> TransportRequest
      | (?url: URI::Generic?, ?http_method: String?, ?headers: headers?, ?body: String?, ?response_limit: Integer?, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation?) -> _PartialTransportRequest
      | ({ ?url: URI::Generic?, ?http_method: String?, ?headers: headers?, ?body: String?, ?response_limit: Integer?, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation? }) -> _PartialTransportRequest
    def self.[]: (url: URI::Generic, http_method: String, headers: headers, body: String, response_limit: Integer, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation?) -> TransportRequest
      | ({ url: URI::Generic, http_method: String, headers: headers, body: String, response_limit: Integer, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation? }) -> TransportRequest
      | (?url: URI::Generic?, ?http_method: String?, ?headers: headers?, ?body: String?, ?response_limit: Integer?, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation?) -> _PartialTransportRequest
      | ({ ?url: URI::Generic?, ?http_method: String?, ?headers: headers?, ?body: String?, ?response_limit: Integer?, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation? }) -> _PartialTransportRequest
    attr_accessor url: URI::Generic
    attr_accessor http_method: String
    attr_accessor headers: headers
    attr_accessor body: String
    attr_accessor response_limit: Integer
    attr_accessor deadline: Deadline?
    attr_accessor lifecycle: Instrumentation::Handle?
    attr_accessor cancellation: _Cancellation?
    def []: (:url | "url" | 0 | -8) -> URI::Generic
      | (:http_method | "http_method" | 1 | -7) -> String
      | (:headers | "headers" | 2 | -6) -> headers
      | (:body | "body" | 3 | -5) -> String
      | (:response_limit | "response_limit" | 4 | -4) -> Integer
      | (:deadline | "deadline" | 5 | -3) -> Deadline?
      | (:lifecycle | "lifecycle" | 6 | -2) -> Instrumentation::Handle?
      | (:cancellation | "cancellation" | 7 | -1) -> _Cancellation?
    def []=: (:url | "url" | 0 | -8, URI::Generic) -> URI::Generic
      | (:http_method | "http_method" | 1 | -7, String) -> String
      | (:headers | "headers" | 2 | -6, headers) -> headers
      | (:body | "body" | 3 | -5, String) -> String
      | (:response_limit | "response_limit" | 4 | -4, Integer) -> Integer
      | (:deadline | "deadline" | 5 | -3, Deadline?) -> Deadline?
      | (:lifecycle | "lifecycle" | 6 | -2, Instrumentation::Handle?) -> Instrumentation::Handle?
      | (:cancellation | "cancellation" | 7 | -1, _Cancellation?) -> _Cancellation?
    def to_h: () -> Hash[Symbol, URI::Generic | String | headers | Integer | Deadline? | Instrumentation::Handle? | _Cancellation?]
    def members: () -> Array[Symbol]
    def size: () -> Integer
    def length: () -> Integer
    def to_a: () -> Array[URI::Generic | String | headers | Integer | Deadline? | Instrumentation::Handle? | _Cancellation?]
    def values: () -> Array[URI::Generic | String | headers | Integer | Deadline? | Instrumentation::Handle? | _Cancellation?]
    def deconstruct: () -> Array[URI::Generic | String | headers | Integer | Deadline? | Instrumentation::Handle? | _Cancellation?]
    def each: () { (URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil) -> void } -> self
            | () -> Enumerator[URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil, self]
    def each_pair: () { ([Symbol, URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil]) -> void } -> self
                 | () -> Enumerator[[Symbol, URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil], self]
    def deconstruct_keys: (Array[Symbol]?) -> Hash[Symbol, URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil]
    def values_at: (*(Integer | Range[Integer])) -> Array[URI::Generic | String | headers | Integer | Deadline | Instrumentation::Handle | _Cancellation | nil | nil]

  end

  interface _PartialTransportResponse
    def status: () -> Integer?
    def status=: (Integer?) -> Integer?
    def headers: () -> headers?
    def headers=: (headers?) -> headers?
    def body: () -> String?
    def body=: (String?) -> String?
    def []: (:status | "status" | 0 | -3) -> Integer?
      | (:headers | "headers" | 1 | -2) -> headers?
      | (:body | "body" | 2 | -1) -> String?
    def []=: (:status | "status" | 0 | -3, Integer?) -> Integer?
      | (:headers | "headers" | 1 | -2, headers?) -> headers?
      | (:body | "body" | 2 | -1, String?) -> String?
    def to_h: () -> Hash[Symbol, Integer? | headers? | String?]
    def members: () -> Array[Symbol]
    def size: () -> Integer
    def length: () -> Integer
    def to_a: () -> Array[Integer? | headers? | String?]
    def values: () -> Array[Integer? | headers? | String?]
    def deconstruct: () -> Array[Integer? | headers? | String?]
    def each: () { (Integer | headers | String | nil) -> void } -> self
            | () -> Enumerator[Integer | headers | String | nil, self]
    def each_pair: () { ([Symbol, Integer | headers | String | nil]) -> void } -> self
                 | () -> Enumerator[[Symbol, Integer | headers | String | nil], self]
    def deconstruct_keys: (Array[Symbol]?) -> Hash[Symbol, Integer | headers | String | nil]
    def values_at: (*(Integer | Range[Integer])) -> Array[Integer | headers | String | nil | nil]

  end

  class TransportResponse
    def self.new: (status: Integer, headers: headers, body: String) -> TransportResponse
      | ({ status: Integer, headers: headers, body: String }) -> TransportResponse
      | (?status: Integer?, ?headers: headers?, ?body: String?) -> _PartialTransportResponse
      | ({ ?status: Integer?, ?headers: headers?, ?body: String? }) -> _PartialTransportResponse
    def self.[]: (status: Integer, headers: headers, body: String) -> TransportResponse
      | ({ status: Integer, headers: headers, body: String }) -> TransportResponse
      | (?status: Integer?, ?headers: headers?, ?body: String?) -> _PartialTransportResponse
      | ({ ?status: Integer?, ?headers: headers?, ?body: String? }) -> _PartialTransportResponse
    attr_accessor status: Integer
    attr_accessor headers: headers
    attr_accessor body: String
    def []: (:status | "status" | 0 | -3) -> Integer
      | (:headers | "headers" | 1 | -2) -> headers
      | (:body | "body" | 2 | -1) -> String
    def []=: (:status | "status" | 0 | -3, Integer) -> Integer
      | (:headers | "headers" | 1 | -2, headers) -> headers
      | (:body | "body" | 2 | -1, String) -> String
    def to_h: () -> Hash[Symbol, Integer | headers | String]
    def members: () -> Array[Symbol]
    def size: () -> Integer
    def length: () -> Integer
    def to_a: () -> Array[Integer | headers | String]
    def values: () -> Array[Integer | headers | String]
    def deconstruct: () -> Array[Integer | headers | String]
    def each: () { (Integer | headers | String) -> void } -> self
            | () -> Enumerator[Integer | headers | String, self]
    def each_pair: () { ([Symbol, Integer | headers | String]) -> void } -> self
                 | () -> Enumerator[[Symbol, Integer | headers | String], self]
    def deconstruct_keys: (Array[Symbol]?) -> Hash[Symbol, Integer | headers | String]
    def values_at: (*(Integer | Range[Integer])) -> Array[Integer | headers | String | nil]

  end

  class Metadata
    include Enumerable[[String, Array[String]]]
    def initialize: (?metadata_input values) -> void
    def self.reserved?: (String) -> bool
    def self.encode_binary: (String) -> String
    def self.decode_binary: (String) -> String
    def []: (String key) -> Array[String]?
    def []=: (String key, String | Array[String] entries) -> Array[String]
    def add: (String key, String value) -> self
    def add_binary: (String key, String bytes) -> self
    def binary: (String key) -> Array[String]
    def each: () { ([String, Array[String]]) -> void } -> headers
            | () -> Enumerator[[String, Array[String]], headers]
    def to_h: () -> headers
  end

  class Deadline
    MAX_NATIVE_WAIT: Float
    def initialize: (Numeric timeout, ?clock: ^() -> Numeric | _Clock) -> void
    def remaining: () -> Numeric
    def expired?: () -> bool
    def native_timeout: () -> Numeric
    def check!: () -> nil
    def timeout_ms: () -> String
  end

  class Context
    def initialize: (?request_metadata: metadata_input, ?deadline: Deadline?, ?lifecycle: Instrumentation::Handle?, ?cancellation: _Cancellation?) -> void
    attr_reader request_metadata: Metadata
    attr_reader response_metadata: Metadata
    attr_reader response_trailers: Metadata
    attr_reader deadline: Deadline?
    def record_failure: (Exception error) -> nil
    def cancelled?: () -> bool
    def check!: () -> nil
    def cancellation_reason: () -> cancellation_reason?
  end

  class CodecError < StandardError
  end

  class ErrorDetail
    def initialize: (type: String, value: String) -> void
    attr_reader type: String
    attr_reader value: String
    def decode: (binding: _Binding, type: Object) -> untyped
    def to_h: () -> Hash[String, String]
  end

  class Error < StandardError
    def initialize: (String | Symbol code, ?String message, ?details: Array[ErrorDetail], ?metadata: metadata_input, ?trailers: metadata_input) -> void
    attr_reader code: String
    attr_reader details: Array[ErrorDetail]
    attr_reader metadata: Metadata
    attr_reader trailers: Metadata
    def http_status: () -> Integer
    def to_h: () -> Hash[String, String | Array[Hash[String, String]]]
  end
end
