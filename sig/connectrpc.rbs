module ConnectRPC
  type grpc_cardinality = :unary | streaming_cardinality
  interface _GRPCStatusCodec
    def encode_status: (Error) -> String
    def decode_status: (String, code: Integer) -> Error
  end
  interface _GRPCTransport
    def grpc_capabilities: () -> Array[grpc_cardinality]
    def open_grpc_stream: [T] (StreamRequest) { (_GRPCStreamExchange) -> T } -> T
