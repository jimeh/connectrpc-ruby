{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "ruby",
      "component": "connectrpc",
      "version-file": "lib/connectrpc/version.rb",
      "initial-version": "0.1.0",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft-pull-request": true,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        "gems/connectrpc-rack/lib/connectrpc/rack/version.rb",
        "gems/connectrpc-rails/lib/connectrpc/rails/version.rb",
        "gems/connectrpc-async/lib/connectrpc/async/version.rb",
        "gems/connectrpc-falcon/lib/connectrpc/falcon/version.rb",
        "gems/connectrpc-testing/lib/connectrpc/testing/version.rb",
        "gems/connectrpc-otel/lib/connectrpc/otel/version.rb"
      ]
    }
  }
}
