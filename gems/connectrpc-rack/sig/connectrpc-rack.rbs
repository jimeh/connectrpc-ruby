module ConnectRPC
  class Rack
    VERSION: String
    type env = Hash[String, Object]
    type response_headers = Hash[String, String | Array[String]]
    type response = [Integer, response_headers, _Body | _CallableBody]
    interface _Body
      def each: () { (String) -> void } -> void
    end
    interface _Stream
      def read: (?nil, ?String?) -> String
              | (Integer?, ?String?) -> String?
      def write: (String) -> Integer
      # Protocol::HTTP returns a byte count; ordinary IO returns itself.
      def <<: (String) -> (Integer | self)
      def flush: () -> void
      def close: () -> void
      def close_read: () -> void
      def close_write: () -> void
      def closed?: () -> bool
    end
    interface _CallableBody
      def call: (_Stream) -> void
    end
    interface _App
      def call: (env) -> response
    end
    def initialize: (?(_App | ^(env) -> response)?, server: Server) -> void
    def call: (env) -> response
  end
end
