module ConnectRPC
  class Rack
    type env = Hash[String, Object]
    type response_headers = Hash[String, String | Array[String]]
    type response = [Integer, response_headers, _Body | _CallableBody]
    interface _Body
      def each: () { (String) -> void } -> void
    end
    interface _Stream
      def write: (String) -> Integer
      def close: () -> void
    end
    interface _CallableBody
      def call: (_Stream) -> void
    end
    interface _App
      def call: (env) -> response
    end
    def initialize: (?(_App | ^(env) -> response)?, server: Server) -> void
    def call: (env) -> response
  end
end
