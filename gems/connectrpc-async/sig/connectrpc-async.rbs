module ConnectRPC
  module Async
    VERSION: String
    # Raised when a lifecycle operation runs outside its owning reactor,
    # thread or allowed state.
    class LifecycleError < StandardError
    end
    type tls = { certificate_chain: Array[String], private_key: String, client_ca: Array[String]? }
    type tls_snapshot = { version: String, certificate_chain: Array[String], private_key: String, client_ca: Array[String]? }
    type tls_category = :invalid | :source | :version_conflict | :timeout | :closed | :expired
    type tls_status = { state: :new | :starting | :running | :closing | :closed, generation: Integer?, category: tls_category?, source_check_age: Float?, publication_age: Float?, identity_expires_at: Time? }
    type tls_event = { category: tls_category, status: tls_status }
    interface _TLSProvider
      def call: () -> tls_snapshot
    end
    interface _TLSErrorHandler
      def call: (tls_event) -> void
    end
    interface _Callback
      def call: () -> void
    end
    interface _Headers
      def header: () -> Enumerator[[String, String], Array[[String, String]]]
    end
    interface _Body
      def read: () -> String?
      def length: () -> Integer?
      def close: (?Exception?) -> void
    end
    interface _Request
      def path: () -> String
      def method: () -> String
      def headers: () -> _Headers
      def body: () -> _Body?
    end
    # async-http closes a bodyless response after sending it.
    interface _Response
      def status: () -> Integer
      def headers: () -> _Headers
      def body: () -> _Body?
      def body=: (_Body?) -> _Body?
      def close: (?Exception?) -> void
    end
    interface _Application
      def call: (_Request, ?lifecycle: Instrumentation::Handle?) -> _Response?
    end
    interface _LifecycleFactory
      def call: (_Request) -> Instrumentation::Handle?
    end
    # A scheduled task is opaque apart from its supported wait/stop operations.
    interface _Task
      def wait: () -> top
      def stop: () -> void
    end
    interface _Socket
      def close: () -> void
      def closed?: () -> bool
      def remote_address: () -> Addrinfo
    end
    interface _Accepted
      def serve: () -> void
      def close: () -> void
      def wait_closed: () -> nil
      def timeout=: (Numeric?) -> Numeric?
      def remote_address: () -> Addrinfo
    end
    class Application
      def initialize: (server: Server, ?fallback: (_Application | ^(_Request) -> _Response?)?) -> void
      def start_call: (_Request) -> Instrumentation::Handle?
      def call: (_Request, ?lifecycle: Instrumentation::Handle?) -> _Response?
    end
    class TLSConfiguration
      class Error < ArgumentError
        def initialize: (tls_category) -> void
        attr_reader category: tls_category
      end
      def initialize: (?tls: tls?, ?tls_provider: (_TLSProvider | ^() -> tls_snapshot)?, ?refresh_interval: Numeric, ?refresh_jitter: Numeric, ?refresh_timeout: Numeric, ?on_error: (_TLSErrorHandler | ^(tls_event) -> void)?, ?alpn_protocols: Array[String]) -> void
      attr_reader generation: Integer?
      def status: () -> tls_status
      def start: () -> self
      def refresh: () -> Integer
      def reload: (certificate_chain: Array[String], private_key: String, client_ca: Array[String]?) -> Integer
      def close: () -> self
    end
    # Server HTTP/2 keepalive PINGs, PING enforcement and connection age.
    class ServerKeepalive
      def initialize: (?time: Numeric?, ?timeout: Numeric, ?min_time: Numeric?, ?permit_without_calls: bool, ?max_connection_age: Numeric?, ?max_connection_age_grace: Numeric?) -> void
      attr_reader time: Numeric?
      attr_reader timeout: Numeric
      attr_reader min_time: Numeric?
      attr_reader permit_without_calls: bool
      attr_reader max_connection_age: Numeric?
      attr_reader max_connection_age_grace: Numeric?
      def ==: (untyped other) -> bool
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
    end
    class Host
      def initialize: (server: Server, ?host: String, ?port: Integer, ?tls: tls?, ?tls_provider: (_TLSProvider | ^() -> tls_snapshot)?, ?max_connections: Integer, ?max_requests: Integer, ?handshake_timeout: Numeric, ?idle_timeout: Numeric?, ?refresh_interval: Numeric, ?refresh_jitter: Numeric, ?refresh_timeout: Numeric, ?on_tls_error: (_TLSErrorHandler | ^(tls_event) -> void)?, ?keepalive: ServerKeepalive?, ?fallback: (_Application | ^(_Request) -> _Response?)?, ?max_concurrent_streams: Integer, ?request_body_timeout: Numeric?, ?response_body_timeout: Numeric?, ?frame_write_timeout: Numeric?, ?stream_receive_window: Integer, ?connection_receive_window: Integer, ?dynamic_receive_windows: bool, ?max_receive_window: Integer) -> void
      attr_reader port: Integer?
      attr_reader addresses: Array[Addrinfo]
      def start: () -> self
      def wait: () -> nil
      def close: (?grace: Numeric) -> bool?
      def reload_tls: (certificate_chain: Array[String], private_key: String, client_ca: Array[String]?) -> Integer
      def refresh_tls: () -> Integer
      def drain_tls: (?grace: Numeric) -> bool
      def tls_generation: () -> Integer?
      def tls_status: () -> tls_status
      def peer_certificate: () -> OpenSSL::X509::Certificate?
    end
    type connection_state = :idle | :connecting | :ready | :transient_failure | :closing | :closed
    # Attempt outcomes, then connection_closed reasons (:closed is shared).
    type connection_outcome = :ready | :refused | :timeout | :tls | :protocol | :closed | :other | :keepalive_timeout | :drain_timeout | :goaway
    type connection_event_type = :state_changed | :attempt_finished | :admission_rejected | :connection_closed | :counts_changed
    class Backoff
      def initialize: (?base: Numeric, ?multiplier: Numeric, ?jitter: Numeric, ?max: Numeric) -> void
      attr_reader base: Numeric
      attr_reader multiplier: Numeric
      attr_reader jitter: Numeric
      attr_reader max: Numeric
      def ==: (untyped other) -> bool
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
    end
    # Since 0.3.0 an alias of core's ConnectRPC::Keepalive.
    class Keepalive = ::ConnectRPC::Keepalive
    class ConnectionPolicy
      def initialize: (?backoff: Backoff?, ?wait_for_ready: bool, ?max_pending_bytes: Integer?, ?retry_refused: bool, ?max_draining: Integer, ?drain_timeout: Numeric?, ?keepalive: Keepalive?) -> void
      attr_reader backoff: Backoff?
      attr_reader wait_for_ready: bool
      attr_reader max_pending_bytes: Integer?
      attr_reader retry_refused: bool
      attr_reader max_draining: Integer
      attr_reader drain_timeout: Numeric?
      attr_reader keepalive: Keepalive?
      def ==: (untyped other) -> bool
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
    end
    # Frozen observation values, delivered on the owner reactor.
    class ConnectionEvent
      attr_reader type: connection_event_type
      attr_reader state: connection_state
      attr_reader previous_state: connection_state?
      attr_reader outcome: connection_outcome?
      attr_reader duration: Float?
      attr_reader active: Integer
      attr_reader draining: Integer
      attr_reader pending_calls: Integer
      attr_reader pending_bytes: Integer
    end
    interface _ConnectionObserver
      def call: (ConnectionEvent) -> void
    end
    class Transport
      def initialize: (origin: String, ?ca_file: String?, ?certificate_chain: Array[String]?, ?private_key: String?, ?connection_limit: Integer, ?max_requests: Integer, ?connect_timeout: Numeric, ?connection_policy: ConnectionPolicy, ?connection_observer: (_ConnectionObserver | ^(ConnectionEvent) -> void)?, ?stream_receive_window: Integer, ?connection_receive_window: Integer, ?dynamic_receive_windows: bool, ?max_receive_window: Integer) -> void
      def connection_state: () -> connection_state
      def grpc_capabilities: () -> Array[grpc_cardinality]
    def open_grpc_stream: [T] (StreamRequest) { (_GRPCStreamExchange) -> T } -> T
    def streaming_capabilities: () -> Array[streaming_cardinality]
      def open_stream: [T] (StreamRequest) { (_StreamExchange) -> T } -> T
      def call: (TransportRequest) -> TransportResponse
      def close: (?grace: Numeric) -> bool
    end
    # Connect unary and server streaming, and native gRPC unary and server
    # streaming, from any thread through one owner thread per process. Stream
    # blocks run on the caller's thread. call, the stream methods, exchange
    # operations and close raise LifecycleError on that owner thread.
    class ThreadedTransport
      def initialize: (origin: String, ?ca_file: String?, ?certificate_chain: Array[String]?, ?private_key: String?, ?connection_limit: Integer, ?max_requests: Integer, ?connect_timeout: Numeric, ?connection_policy: ConnectionPolicy, ?connection_observer: (_ConnectionObserver | ^(ConnectionEvent) -> void)?, ?stream_receive_window: Integer, ?connection_receive_window: Integer, ?dynamic_receive_windows: bool, ?max_receive_window: Integer) -> void
      def connection_state: () -> connection_state
      def call: (TransportRequest) -> TransportResponse
      def streaming_capabilities: () -> Array[:server_stream]
      def open_stream: [T] (StreamRequest) { (_StreamExchange) -> T } -> T
      def grpc_capabilities: () -> Array[:unary | :server_stream]
      def open_grpc_stream: [T] (StreamRequest) { (_GRPCStreamExchange) -> T } -> T
      def close: (?grace: Numeric) -> bool
    end
    # Since 0.3.0. Connect unary and server streaming, and native gRPC unary
    # and server streaming, over one HTTP/2 connection per call to the
    # request URL's origin, from any thread or inline in an Async task. Each
    # call closes its own connection, so there is no close.
    class PerCallTransport
      def initialize: (?ca_file: String?, ?certificate_chain: Array[String]?, ?private_key: String?, ?connect_timeout: Numeric) -> void
      def call: (TransportRequest) -> TransportResponse
      def streaming_capabilities: () -> Array[:server_stream]
      def open_stream: [T] (StreamRequest) { (_StreamExchange) -> T } -> T
      def grpc_capabilities: () -> Array[:unary | :server_stream]
      def open_grpc_stream: [T] (StreamRequest) { (_GRPCStreamExchange) -> T } -> T
    end
    class HTTP1Transport
      def initialize: (origin: String, ?ca_file: String?, ?certificate_chain: Array[String]?, ?private_key: String?, ?connection_limit: Integer, ?max_requests: Integer, ?connect_timeout: Numeric) -> void
      def streaming_capabilities: () -> Array[:server_stream | :client_stream]
      def open_stream: [T] (StreamRequest) { (_StreamExchange) -> T } -> T
      def call: (TransportRequest) -> TransportResponse
      def close: (?grace: Numeric) -> bool
    end
    class ServerSession
      # http1 is a backend resource-construction boundary, deliberately opaque.
      interface _HTTP1Factory
        def call: (Object, progress: Object, generation: Integer?) -> Object
      end
      def initialize: (application: _Application | ^(_Request, ?lifecycle: Instrumentation::Handle?) -> _Response?, ?tls: tls?, ?tls_provider: (_TLSProvider | ^() -> tls_snapshot)?, ?max_connections: Integer, ?max_requests: Integer, ?handshake_timeout: Numeric, ?idle_timeout: Numeric?, ?refresh_interval: Numeric, ?refresh_jitter: Numeric, ?refresh_timeout: Numeric, ?on_tls_error: (_TLSErrorHandler | ^(tls_event) -> void)?, ?alpn_protocols: Array[String], ?http1: _HTTP1Factory?, ?stop_accepting: (_Callback | ^() -> void)?, ?on_request_rejected: (_Callback | ^() -> void)?, ?lifecycle_factory: (_LifecycleFactory | ^(_Request) -> Instrumentation::Handle?)?, ?keepalive: ServerKeepalive?, ?max_concurrent_streams: Integer, ?request_body_timeout: Numeric?, ?response_body_timeout: Numeric?, ?frame_write_timeout: Numeric?, ?stream_receive_window: Integer, ?connection_receive_window: Integer, ?dynamic_receive_windows: bool, ?max_receive_window: Integer) -> void
      def start: () -> self
      def close: (?grace: Numeric) -> bool?
      def abort: () -> self
      def accept: (_Socket) -> _Accepted?
      def schedule: () { (_Task) -> top } -> _Task
      def reload_tls: (certificate_chain: Array[String], private_key: String, client_ca: Array[String]?) -> Integer
      def refresh_tls: () -> Integer
      def drain_tls: (?grace: Numeric) -> bool
      def tls_generation: () -> Integer?
      def tls_status: () -> tls_status
      def peer_certificate: () -> OpenSSL::X509::Certificate?
    end
  end
end
