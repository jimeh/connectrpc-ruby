# Runtime dependencies float within gemspec constraints; only tools stay exact.
# Rails, ActiveRecord, the OpenTelemetry SDK and sentry-opentelemetry are
# development-only. sentry-rails and sentry-opentelemetry follow sentry-ruby's
# version, including the 6.7.0 floor.
group :development, :test do
  gem "activerecord", require: false
  gem "google-protobuf", "4.36.2", require: false
  gem "opentelemetry-sdk", require: false
  gem "rackup", "2.3.1", require: false
  gem "railties", require: false
  gem "rake", "13.4.2", require: false
  gem "rspec", "3.13.2", require: false
  gem "rubocop", "1.92.1", require: false
  gem "sentry-opentelemetry", require: false
  gem "sentry-rails", require: false
  gem "simplecov", "1.3.2", require: false
  gem "sqlite3", require: false
  gem "webrick", "1.9.2", require: false
end
