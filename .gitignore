# Development bundles resolve fresh within gemspec constraints; locks stay local.
/Gemfile.lock
/gems/*/Gemfile.lock
/gems/*/gemfiles/*.gemfile.lock
# Generated lowest-allowed (CONNECTRPC_DEPENDENCY_FLOORS=1) wrappers and locks.
Gemfile.floors
*.floors.gemfile
*.floors.lock
*.floors.gemfile.lock
# Generated pins-lifted canary (CONNECTRPC_DEPENDENCY_CANARY=1) wrappers and locks.
Gemfile.canary
Gemfile.canary.lock
